# Database configuration
DATABASE_HOST=localhost
DATABASE_PORT=55434
DATABASE_NAME=test_service
DATABASE_USER=postgresqldba
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Authentication. Production requires a JWKS endpoint; issuer and audience are optional.
# Set to true only for local development.
AUTH_MOCK_ENABLED=true
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# Xray Cloud. Keep actual credentials only in .env or your secret manager.
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_AUTH_URL=https://xray.cloud.getxray.app/api/v2/authenticate
XRAY_GRAPHQL_URL=https://xray.cloud.getxray.app/api/v2/graphql
XRAY_TIMEOUT_SECONDS=10
# Standard Xray Cloud plan limit: 300 requests per 5 minutes.
XRAY_RATE_LIMIT_REQUESTS=300
XRAY_RATE_LIMIT_WINDOW_SECONDS=300

# Jira validation. Local placeholders allow the app to start; use real values
# when exercising project validation.
JIRA_BASE_URL=https://jira.local
JIRA_USER_EMAIL=local@example.test
JIRA_API_TOKEN=local

# SonarQube is used only by `make sonar`; leave these empty unless needed.
SONAR_HOST_URL=
SONAR_TOKEN=

# Secrets an Environment can reference as {"provider": "env", "referenceKey": "API_KEY"}.
# Only variables with this prefix are readable; the service's own credentials never are.
# TEST_SERVICE_SECRET_API_KEY=
