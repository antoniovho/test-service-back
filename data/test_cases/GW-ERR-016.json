{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-ERR-016",
  "summary": "Gateway rate limit returns throttling_error",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "rate_limited_api_key": "replace-with-key-limited-to-one-request-per-window",
      "model_name": "replace-with-configured-chat-model"
    },
    "actions": [
      {
        "id": "gatewayRateLimit",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{rate_limited_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ]
          },
          "expectedStatus": 429,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "throttling_error"
                  },
                  "param": {
                    "type": [
                      "null",
                      "string"
                    ]
                  },
                  "code": {
                    "const": "429"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify that a second request made in the same rate-limit window after a key's one-request allowance has been consumed is rejected with throttling_error and HTTP 429. Dynamic rate-limit response headers are not asserted by this corpus case.",
    "labels": [
      "litellm",
      "error-handling",
      "rate-limit",
      "throttling"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
