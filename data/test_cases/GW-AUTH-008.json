{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-AUTH-008",
  "summary": "JWT OIDC authentication and authorization",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "jwt_token": "replace-with-valid-non-admin-jwt",
      "model_name": "replace-with-model-authorized-for-jwt"
    },
    "actions": [
      {
        "id": "jwtModelAccess",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{jwt_token}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return a short confirmation."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              }
            }
          }
        }
      },
      {
        "id": "jwtAdminScopeDenied",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/key/generate",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{jwt_token}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "models": [
              "{{model_name}}"
            ]
          },
          "expectedStatus": 401,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "auth_error"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "For an Enterprise LiteLLM deployment configured for JWT authentication, verify a valid non-admin JWT may access its authorized model but cannot perform key administration. JWKS/OIDC settings, required claims, audience validation, and the non-admin scope must be configured by the environment.",
    "labels": [
      "litellm",
      "auth",
      "jwt",
      "oidc",
      "enterprise"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
