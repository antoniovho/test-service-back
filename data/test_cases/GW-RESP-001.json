{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-RESP-001",
  "summary": "Create, retrieve, and delete a Responses API response",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-responses-api-key",
      "responses_model_name": "replace-with-model-supporting-responses-api"
    },
    "actions": [
      {
        "id": "createResponse",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/responses",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{responses_model_name}}",
            "input": "Return a short confirmation.",
            "stream": false
          },
          "expectedStatus": 200,
          "expectedHeaders": {
            "Content-Type": "application/json"
          },
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "id",
              "object",
              "model",
              "output"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "object": {
                "const": "response"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "output": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "capture": {
            "response_id": "$.id"
          }
        }
      },
      {
        "id": "retrieveCreatedResponse",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/responses/{response_id}",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Accept": "application/json"
          },
          "expectedStatus": 200
        }
      },
      {
        "id": "deleteCreatedResponse",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/responses/{response_id}",
          "method": "DELETE",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Accept": "application/json"
          },
          "expectedStatus": 200
        }
      }
    ]
  },
  "metadata": {
    "objective": "Also covers GW-API-003's standalone response creation contract. Verify the Responses API accepts creation, retrieval by captured ID, and deletion of a response. The delete applies only to the disposable response created by this case. The runner does not poll for asynchronous completion or validate generated response content; the initial model request can incur provider costs.",
    "labels": [
      "litellm",
      "responses-api",
      "lifecycle",
      "create",
      "retrieve",
      "delete",
      "GW-API-003"
    ],
    "source": "https://docs.litellm.ai/docs/response_api"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
