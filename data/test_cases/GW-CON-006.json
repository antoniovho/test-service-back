{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-CON-006",
  "summary": "Choice schema",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "chatChoiceSchema",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "index",
                    "message",
                    "finish_reason"
                  ],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "message": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "const": "assistant"
                        },
                        "content": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    },
                    "finish_reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify every non-streaming completion choice contains a nonnegative integer index, assistant message fields, and finish-reason metadata. Output text is provider-generated and is not pinned to an exact value.",
    "labels": [
      "litellm",
      "contract",
      "chat-completions",
      "choices"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
