{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-CON-013",
  "summary": "Content-type tolerance for JSON bodies",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "jsonContentTypeAccepted",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedHeaders": {
            "Content-Type": "application/json"
          }
        }
      },
      {
        "id": "jsonBodyAcceptedWhenLabeledTextPlain",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "text/plain",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedHeaders": {
            "Content-Type": "application/json"
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify LiteLLM accepts a JSON body with both application/json and text/plain Content-Type declarations, returning an OpenAI-compatible JSON response. LiteLLM parses the body as JSON independently of the declared content type. The runner serializes the configured JSON body and does not support a raw request-body field, so this case does not test rejection of arbitrary non-JSON text.",
    "labels": [
      "litellm",
      "contract",
      "content-type",
      "media-type",
      "tolerance"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
