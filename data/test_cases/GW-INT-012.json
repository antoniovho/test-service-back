{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-INT-012",
  "summary": "Enforce a shared rate limit across LiteLLM Proxy instances",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "gateway_instance_1_url": "replace-with-first-proxy-instance-url",
      "gateway_instance_2_url": "replace-with-second-proxy-instance-url",
      "selected_gateway_instance_url": "replace-with-either-proxy-instance-url",
      "rate_limit_test_key": "replace-with-disposable-key-limited-to-two-rpm",
      "model_name": "replace-with-configured-chat-model"
    },
    "actions": [
      {
        "id": "requestThroughFirstProxy",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_instance_1_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{rate_limit_test_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Distributed rate-limit request one."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "choices"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              },
              "choices": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      },
      {
        "id": "requestThroughSecondProxy",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_instance_2_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{rate_limit_test_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Distributed rate-limit request two."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "choices"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              },
              "choices": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      },
      {
        "id": "rejectRequestAcrossSharedLimit",
        "type": "HTTP",
        "configuration": {
          "url": "{{selected_gateway_instance_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{rate_limit_test_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Distributed rate-limit request three."
              }
            ],
            "stream": false
          },
          "expectedStatus": 429,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "type",
                  "code"
                ],
                "properties": {
                  "message": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "const": "rate_limit_error"
                  },
                  "code": {
                    "oneOf": [
                      {
                        "const": "429"
                      },
                      {
                        "const": 429
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify two accepted requests sent to separate LiteLLM Proxy instances share one RPM counter and a third request is rejected with HTTP 429. Requires both instances to use the same Redis-backed rate-limit configuration and a disposable key with an RPM limit of two. Requests can incur provider costs; execute only against an isolated test deployment. This sequential check does not test high-volume drift or concurrent traffic tolerance.",
    "labels": [
      "litellm",
      "integration",
      "redis",
      "rate-limiting",
      "multi-instance"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
