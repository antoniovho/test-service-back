{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-CON-010",
  "summary": "Invalid payload contract",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "messagesWrongType",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": "invalid-message-value",
            "stream": false
          },
          "expectedStatus": 400
        }
      },
      {
        "id": "messageContentWrongType",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": {
                  "nested": "invalid-content-shape"
                }
              }
            ],
            "stream": false
          },
          "expectedStatus": 400
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify malformed chat payloads are rejected when messages has the wrong type or message content has invalid nesting. The missing-messages case is covered by GW-CON-001 and GW-SMK-006, so this case avoids repeating that request. Error response bodies are intentionally not pinned to version-specific wording.",
    "labels": [
      "litellm",
      "contract",
      "validation",
      "negative"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
