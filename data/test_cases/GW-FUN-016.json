{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-FUN-016",
  "summary": "Use prior turns when answering a follow-up question",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-chat-api-key",
      "model_name": "replace-with-configured-chat-model"
    },
    "actions": [
      {
        "id": "conversationContextFollowup",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "I'm planning a trip to Kyoto in Japan."
              },
              {
                "role": "assistant",
                "content": "Kyoto is a great choice! It's known for its temples and gardens."
              },
              {
                "role": "user",
                "content": "What's a good local dish to try there? Please include either the word kaiseki or yudofu."
              }
            ]
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "choices"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message",
                    "finish_reason"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "content"
                      ],
                      "properties": {
                        "content": {
                          "type": "string",
                          "pattern": "(?i)(kaiseki|yudofu)"
                        }
                      }
                    },
                    "finish_reason": {
                      "const": "stop"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify the multi-turn chat request succeeds and the follow-up answer includes kaiseki or yudofu, terms explicitly requested for a Kyoto dish. This deterministic content check is only a proxy for semantic context preservation and does not prove overall answer coherence. The provider call can incur token costs.",
    "labels": [
      "litellm",
      "functional",
      "chat-completions",
      "conversation-context",
      "multi-turn"
    ],
    "source": "https://docs.litellm.ai/docs/completion"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
