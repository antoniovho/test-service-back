{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-LIM-005",
  "summary": "Keep team rate limits isolated between teams",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "team_a_api_key": "replace-with-dedicated-team-a-key-rpm-1",
      "team_b_api_key": "replace-with-dedicated-team-b-key-rpm-1",
      "model_name": "replace-with-configured-chat-model"
    },
    "actions": [
      {
        "id": "teamAWithinLimit",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{team_a_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Reply with OK."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200
        }
      },
      {
        "id": "teamAOverLimit",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{team_a_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Reply with OK."
              }
            ],
            "stream": false
          },
          "expectedStatus": 429
        }
      },
      {
        "id": "teamBIndependentLimit",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{team_b_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Reply with OK."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200
        }
      }
    ]
  },
  "metadata": {
    "objective": "With two dedicated non-admin teams each configured for rpm_limit=1, verify Team A receives HTTP 200 then HTTP 429 while Team B still receives HTTP 200. Requires an isolated deployment and clean rate-limit buckets for both teams. The case does not test quota reset; accepted completions can incur provider token costs.",
    "labels": [
      "litellm",
      "rate-limiting",
      "per-team",
      "isolation",
      "api-key"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/teams"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
