{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-API-001",
  "summary": "Successful OpenAI-compatible chat completion",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "chatCompletion",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return a short confirmation."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedHeaders": {
            "Content-Type": "application/json"
          },
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "id",
              "object",
              "created",
              "model",
              "choices",
              "usage"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "object": {
                "const": "chat.completion"
              },
              "created": {
                "type": "integer"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "const": "assistant"
                        },
                        "content": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "usage": {
                "type": "object",
                "required": [
                  "prompt_tokens",
                  "completion_tokens",
                  "total_tokens"
                ],
                "properties": {
                  "prompt_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "completion_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "expectedHeaderNames": [
            "x-litellm-call-id",
            "x-litellm-response-cost"
          ]
        }
      }
    ]
  },
  "metadata": {
    "objective": "Also consolidates GW-AUTH-001, GW-SMK-008, GW-SMK-009 and GW-INT-001: one authorized chat request checks the OpenAI response shape, numeric usage fields, a non-empty call ID and response-cost header. Exact output is provider-dependent. The runner does not compare usage arithmetic or numeric cost, prove which deployment was selected, assert call-ID uniqueness across requests, or enforce the source's generic 5-second bound.",
    "labels": [
      "litellm",
      "chat-completions",
      "functional",
      "contract",
      "auth",
      "usage",
      "correlation",
      "GW-AUTH-001",
      "GW-SMK-008",
      "GW-SMK-009",
      "GW-INT-001"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/logging"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
