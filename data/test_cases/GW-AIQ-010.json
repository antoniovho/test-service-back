{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-AIQ-010",
  "summary": "Tool-call correctness",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-tool-call-compatible-model"
    },
    "actions": [
      {
        "id": "weatherToolCall",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "What's the weather in Madrid?"
              }
            ],
            "tools": [
              {
                "type": "function",
                "function": {
                  "name": "get_weather",
                  "description": "Get the current weather for a given city",
                  "parameters": {
                    "type": "object",
                    "properties": {
                      "location": {
                        "type": "string",
                        "description": "City name"
                      }
                    },
                    "required": [
                      "location"
                    ]
                  }
                }
              }
            ],
            "tool_choice": "auto",
            "temperature": 0
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "finish_reason",
                    "message"
                  ],
                  "properties": {
                    "finish_reason": {
                      "const": "tool_calls"
                    },
                    "message": {
                      "type": "object",
                      "required": [
                        "role",
                        "tool_calls"
                      ],
                      "properties": {
                        "role": {
                          "const": "assistant"
                        },
                        "tool_calls": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "object",
                            "required": [
                              "type",
                              "function"
                            ],
                            "properties": {
                              "type": {
                                "const": "function"
                              },
                              "function": {
                                "type": "object",
                                "required": [
                                  "name",
                                  "arguments"
                                ],
                                "properties": {
                                  "name": {
                                    "const": "get_weather"
                                  },
                                  "arguments": {
                                    "type": "string",
                                    "pattern": "^\\s*\\{\\s*\\\"location\\\"\\s*:\\s*\\\"Madrid\\\"\\s*\\}\\s*$"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify that one weather request selects get_weather with Madrid arguments. The runner checks the serialized arguments with a constrained regex instead of parsing them as nested JSON; aggregate tool-call correctness over the evaluation dataset is not measured.",
    "labels": [
      "litellm",
      "ai-quality",
      "tool-calling",
      "function-calling"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
