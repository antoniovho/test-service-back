{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-AIQ-014",
  "summary": "Long-context quality",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-long-context-compatible-model",
      "long_context_document": "replace-with-approved-approximately-100k-token-fixture-with-needle-47281-near-midpoint"
    },
    "actions": [
      {
        "id": "retrieveLongContextNeedle",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "{{long_context_document}}\n\nWhat is the secret code mentioned in the document above?"
              }
            ],
            "temperature": 0,
            "max_tokens": 20
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "const": "assistant"
                        },
                        "content": {
                          "const": "47281"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Retrieve the fact 47281 from a long-context fixture. The source export only contains a placeholder for approximately 100,000 tokens of filler, so the fixture variable must be supplied with the approved full-size document and needle placed near the midpoint; this case does not itself verify token count or retrieval at multiple positions.",
    "labels": [
      "litellm",
      "ai-quality",
      "long-context",
      "needle-in-haystack"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
