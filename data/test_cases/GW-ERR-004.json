{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-ERR-004",
  "summary": "Authentication provider unavailable",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "valid_jwt": "replace-with-valid-jwt-for-configured-identity-provider",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "identityProviderUnavailable",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{valid_jwt}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ]
          },
          "expectedStatus": 503,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "auth_provider_unavailable"
                  },
                  "code": {
                    "const": "503"
                  }
                }
              }
            }
          }
        }
      },
      {
        "id": "proxyLivenessAfterIdentityFailure",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/health/liveliness",
          "method": "GET",
          "expectedStatus": 200
        }
      }
    ]
  },
  "metadata": {
    "objective": "In an isolated test environment, verify an unreachable configured identity provider results in auth_provider_unavailable while the proxy liveness endpoint remains available. Do not induce this dependency failure in a shared or production environment.",
    "labels": [
      "litellm",
      "error-handling",
      "identity-provider",
      "availability"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/health"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
