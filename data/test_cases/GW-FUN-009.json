{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-FUN-009",
  "summary": "Request schema-constrained structured output",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-chat-api-key",
      "model_name": "replace-with-configured-chat-model-supporting-json-schema-output"
    },
    "actions": [
      {
        "id": "structuredOutputRequest",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Give me a fictitious weather reading for Paris."
              }
            ],
            "response_format": {
              "type": "json_schema",
              "json_schema": {
                "name": "weather_response",
                "strict": true,
                "schema": {
                  "type": "object",
                  "properties": {
                    "temperature": {
                      "type": "number"
                    },
                    "condition": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "temperature",
                    "condition"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message",
                    "finish_reason"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "content"
                      ],
                      "properties": {
                        "content": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "finish_reason": {
                      "const": "stop"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Send the json_schema response_format request and verify the Gateway returns a non-empty completion. The corpus runner validates the outer HTTP JSON response but cannot parse choices[0].message.content as a nested JSON document, so this case does not claim to validate generated-content conformance to the requested schema. The configured model must support strict JSON Schema output; the call can incur provider token costs.",
    "labels": [
      "litellm",
      "functional",
      "chat-completions",
      "structured-output",
      "json-schema"
    ],
    "source": "https://docs.litellm.ai/docs/completion/json_schema"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
