{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-STR-004",
  "summary": "Streaming response includes consistent usage metadata",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "checkStreamingUsageMetadata",
        "type": "SSE",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "text/event-stream"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Explain in one sentence what an API is."
              }
            ],
            "stream": true,
            "stream_options": {
              "include_usage": true
            }
          },
          "expectedContentType": "text/event-stream",
          "expectedDataJsonSchema": {
            "type": "object",
            "required": [
              "object"
            ],
            "properties": {
              "object": {
                "const": "chat.completion.chunk"
              }
            }
          },
          "expectedFinalDataJsonSchema": {
            "type": "object",
            "required": [
              "usage"
            ],
            "properties": {
              "usage": {
                "type": "object",
                "required": [
                  "prompt_tokens",
                  "completion_tokens",
                  "total_tokens"
                ],
                "properties": {
                  "prompt_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "completion_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "validateUsageTotals": true,
          "expectedDone": true,
          "maxEvents": 1000,
          "receiveTimeoutSeconds": 30,
          "maxResponseTimeMs": 30000
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify stream_options.include_usage returns usage metadata in the final JSON chunk before [DONE], with nonnegative token counts whose total is internally consistent. Requires streaming usage support and a configured model; execution and its model health precondition can incur provider charges. The total stream is limited to 30 seconds.",
    "labels": [
      "litellm",
      "chat-completions",
      "streaming",
      "usage",
      "sse"
    ]
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
