{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-ERR-005",
  "summary": "Key is not permitted to use requested model",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "restricted_api_key": "replace-with-key-restricted-to-other-models",
      "restricted_model_name": "replace-with-configured-model-not-authorized-for-key"
    },
    "actions": [
      {
        "id": "keyModelAccessDenied",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{restricted_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{restricted_model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ]
          },
          "expectedStatus": 403,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "key_model_access_denied"
                  },
                  "param": {
                    "const": "model"
                  },
                  "code": {
                    "const": "403"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify a virtual key whose model allowlist excludes the requested configured model is rejected with key_model_access_denied and HTTP 403. Provision a dedicated restricted test key and keep the requested model available to the proxy.",
    "labels": [
      "litellm",
      "error-handling",
      "model-access",
      "authorization"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
