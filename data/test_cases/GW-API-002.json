{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-API-002",
  "summary": "Streaming chat completion",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "streamChatCompletion",
        "type": "SSE",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "text/event-stream"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return a short confirmation."
              }
            ],
            "stream": true
          },
          "expectedDone": true,
          "maxEvents": 1000,
          "receiveTimeoutSeconds": 60
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify streaming chat completion terminates with the OpenAI-compatible [DONE] SSE marker. The runner currently does not assert response Content-Type or measure time to first chunk; those checks from the source case are not represented as passing assertions.",
    "labels": [
      "litellm",
      "chat-completions",
      "streaming",
      "sse"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
