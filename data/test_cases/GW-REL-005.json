{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-REL-005",
  "summary": "Update vector-store metadata after proxy creation",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-vector-store-enabled-api-key",
      "vector_store_name": "replace-with-unique-disposable-vector-store-name"
    },
    "actions": [
      {
        "id": "createVectorStoreWithCallerMetadata",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/vector_stores", "method": "POST",
          "headers": {"Authorization": "Bearer {{litellm_virtual_key}}", "Content-Type": "application/json", "Accept": "application/json"},
          "json": {"name": "{{vector_store_name}}", "metadata": {"release": "1.106.1", "owner": "corpus"}},
          "expectedStatus": 200,
          "expectedJsonSchema": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string", "minLength": 1}}},
          "capture": {"vector_store_id": "$.id"}
        }
      },
      {
        "id": "updateCallerMetadata",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/vector_stores/{vector_store_id}", "method": "POST",
          "headers": {"Authorization": "Bearer {{litellm_virtual_key}}", "Content-Type": "application/json", "Accept": "application/json"},
          "json": {"metadata": {"release": "1.106.1", "owner": "corpus", "state": "updated"}},
          "expectedStatus": 200,
          "expectedJsonSchema": {"type": "object", "properties": {"metadata": {"type": "object", "properties": {"state": {"const": "updated"}}}}}
        }
      },
      {
        "id": "deleteDisposableVectorStore",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/vector_stores/{vector_store_id}", "method": "DELETE",
          "headers": {"Authorization": "Bearer {{litellm_virtual_key}}", "Accept": "application/json"},
          "expectedStatus": 200
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify the v1.106.1 vector-store fix: caller metadata survives creation and a later metadata update does not fail with 400. The case creates and deletes only a uniquely named disposable resource; run against an isolated backend.",
    "labels": ["litellm", "release-1.106.1", "vector-store", "metadata", "lifecycle", "regression"],
    "source": "https://docs.litellm.ai/release_notes/v1.106.1/v1-106-1"
  },
  "preconditionReferences": [{"preconditionKey": "LITELLM_PROXY_READY", "version": 1}]
}
