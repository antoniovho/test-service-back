{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-OCR-001",
  "summary": "Submit a PDF URL to the LiteLLM OCR endpoint",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-ocr-api-key",
      "ocr_model_name": "replace-with-configured-mistral-ocr-model-alias"
    },
    "actions": [
      {
        "id": "ocrPdfDocumentUrl",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/ocr",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{ocr_model_name}}",
            "document": {
              "type": "document_url",
              "document_url": "https://arxiv.org/pdf/2201.04234"
            }
          },
          "expectedStatus": 200,
          "expectedHeaders": {
            "Content-Type": "application/json"
          },
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "pages",
              "model",
              "usage_info",
              "object"
            ],
            "properties": {
              "object": {
                "const": "ocr"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "pages": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "index",
                    "markdown",
                    "dimensions"
                  ],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "markdown": {
                      "type": "string"
                    },
                    "dimensions": {
                      "type": "object",
                      "required": [
                        "dpi",
                        "height",
                        "width"
                      ],
                      "properties": {
                        "dpi": {
                          "type": "number"
                        },
                        "height": {
                          "type": "number"
                        },
                        "width": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              },
              "usage_info": {
                "type": "object",
                "required": [
                  "pages_processed",
                  "doc_size_bytes"
                ],
                "properties": {
                  "pages_processed": {
                    "type": "number",
                    "minimum": 0
                  },
                  "doc_size_bytes": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              },
              "document_annotation": {
                "type": [
                  "object",
                  "null"
                ]
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Also covers GW-OCR-007's response-contract checks. Verify the configured OCR model accepts a document_url PDF request and returns pages, markdown, dimensions, and usage metadata. document_annotation is optional per the official API. Requires provider credentials, an OCR deployment, and outbound access to the public document URL; OCR inference can incur provider costs.",
    "labels": [
      "litellm",
      "ocr",
      "document-url",
      "pdf",
      "GW-OCR-007"
    ],
    "source": "https://docs.litellm.ai/docs/ocr"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
