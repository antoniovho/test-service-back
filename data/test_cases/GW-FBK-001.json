{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-FBK-001",
  "summary": "Retry a transient provider failure and recover",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-test-key",
      "model_name": "replace-with-model-using-retry-policy"
    },
    "actions": [
      {
        "id": "retryTransientProviderFailure",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the configured retry test response."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "content"
                      ],
                      "properties": {
                        "content": {
                          "const": "retry-recovered"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "With a deterministic provider fixture configured externally to fail once with a retryable error and then return content=retry-recovered, verify the gateway returns that successful completion. Configure a retry policy for the model. The corpus runner cannot configure the fixture or inspect provider-attempt telemetry, so exact attempt count and absence of extra retries are not asserted.",
    "labels": [
      "litellm",
      "fallback",
      "retry",
      "provider-fixture"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/reliability"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
