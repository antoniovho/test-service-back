{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-API-004",
  "summary": "Generate embeddings",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "embedding_model_name": "replace-with-configured-embedding-model"
    },
    "actions": [
      {
        "id": "createEmbeddings",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/embeddings",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{embedding_model_name}}",
            "input": "LiteLLM embedding integration test"
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "data"
            ],
            "properties": {
              "object": {
                "const": "list"
              },
              "data": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "object",
                    "embedding"
                  ],
                  "properties": {
                    "object": {
                      "const": "embedding"
                    },
                    "embedding": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          },
          "expectedHeaders": {
            "Content-Type": "application/json"
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify that LiteLLM returns OpenAI-compatible embedding data. The selected model must be configured for embeddings and authorized for the key; vector dimensions vary by model and are intentionally not fixed.",
    "labels": [
      "litellm",
      "embeddings",
      "functional",
      "contract"
    ],
    "source": "https://docs.litellm.ai/docs/embedding/supported_embedding"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
