{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-LIM-007",
  "summary": "Reject requests after a dedicated key budget is exhausted",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "budget_test_api_key": "replace-with-dedicated-key-with-small-max-budget",
      "budget_test_model_name": "replace-with-configured-low-cost-chat-model",
      "budget_exhaustion_prompt": "Write a detailed 1000-word report about ocean ecosystems."
    },
    "actions": [
      {
        "id": "requestWithinBudget",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{budget_test_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{budget_test_model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Reply with OK."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200
        }
      },
      {
        "id": "requestAfterBudgetExhaustion",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{budget_test_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{budget_test_model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "{{budget_exhaustion_prompt}}"
              }
            ],
            "stream": false
          },
          "expectedStatus": 429
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify an isolated key with a deliberately small max_budget can make a short initial request and then receives HTTP 429 after additional traffic exhausts its budget. Requires database-backed budget configuration where applicable and a fresh disposable key with a known budget. Both successful model requests can incur provider costs; run only in an isolated environment with spending capped externally. The runner asserts status only and does not assert the provider-specific error type.",
    "labels": [
      "litellm",
      "rate-limiting",
      "budget",
      "spend-control",
      "api-key"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/users"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
