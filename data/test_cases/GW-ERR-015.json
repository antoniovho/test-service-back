{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-ERR-015",
  "summary": "Budget exceeded returns budget_exceeded",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "budget_api_key": "replace-with-key-whose-budget-is-exceeded",
      "model_name": "replace-with-configured-chat-model"
    },
    "actions": [
      {
        "id": "budgetExceeded",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{budget_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ]
          },
          "expectedStatus": 429,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "budget_exceeded"
                  },
                  "code": {
                    "const": "429"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify that a virtual key with max_budget already below its accrued spend is rejected with budget_exceeded and HTTP 429. The budget state must be prepared deterministically before the request. Provider non-invocation and budget/cost details in the error message are not asserted.",
    "labels": [
      "litellm",
      "error-handling",
      "budget",
      "rate-limit"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
