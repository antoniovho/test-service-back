{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-REL-004",
  "summary": "Keep bridged Responses tool calls in the first chat choice",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-api-key",
      "responses_bridge_model_name": "replace-with-chat-model-bridged-to-responses"
    },
    "actions": [
      {
        "id": "requestForcedBridgedToolCall",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {"Authorization": "Bearer {{litellm_virtual_key}}", "Content-Type": "application/json", "Accept": "application/json"},
          "json": {
            "model": "{{responses_bridge_model_name}}",
            "messages": [{"role": "user", "content": "Use the supplied tool."}],
            "tools": [{"type": "function", "function": {"name": "get_status", "description": "Return a status.", "parameters": {"type": "object", "properties": {}, "additionalProperties": false}}}],
            "tool_choice": {"type": "function", "function": {"name": "get_status"}},
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": ["choices"],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {"type": "object", "required": ["message", "finish_reason"], "properties": {"finish_reason": {"const": "tool_calls"}, "message": {"type": "object", "required": ["tool_calls"], "properties": {"tool_calls": {"type": "array", "minItems": 1}}}}}
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify the v1.106.1 chat-to-Responses bridge folds text and tool calls into choices[0] and emits finish_reason=tool_calls. The selected deployment must actually use the bridge; execution can incur provider cost.",
    "labels": ["litellm", "release-1.106.1", "responses-api", "chat-completions", "tool-calling", "regression"],
    "source": "https://docs.litellm.ai/release_notes/v1.106.1/v1-106-1"
  },
  "preconditionReferences": [{"preconditionKey": "LITELLM_PROXY_READY", "version": 1}]
}
