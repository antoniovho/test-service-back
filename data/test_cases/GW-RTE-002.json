{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-RTE-002",
  "summary": "List and request a configured model alias",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-chat-api-key",
      "model_alias": "replace-with-configured-model-alias"
    },
    "actions": [
      {
        "id": "listModelsForAlias",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/models",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Accept": "application/json"
          },
          "expectedStatus": 200
        }
      },
      {
        "id": "requestConfiguredAlias",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_alias}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word ALIAS."
              }
            ]
          },
          "expectedStatus": 200
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify the model-list endpoint and a chat request using the configured alias both return HTTP 200. The environment must map the alias to a healthy target model group and authorize the key. The runner cannot inspect the model-list body or routing telemetry, so it does not assert that the alias appears in the list or that a particular target deployment was selected. The completion can incur provider costs.",
    "labels": [
      "litellm",
      "routing",
      "model-alias",
      "model-list"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/model_management"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
