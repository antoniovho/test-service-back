{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-CON-002",
  "summary": "Chat response schema",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "canonicalChatResponse",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "id",
              "object",
              "created",
              "model",
              "choices",
              "usage"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "object": {
                "const": "chat.completion"
              },
              "created": {
                "type": "integer"
              },
              "model": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "index",
                    "message",
                    "finish_reason"
                  ],
                  "properties": {
                    "index": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "message": {
                      "type": "object"
                    },
                    "finish_reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "usage": {
                "type": "object",
                "required": [
                  "prompt_tokens",
                  "completion_tokens",
                  "total_tokens"
                ],
                "properties": {
                  "prompt_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "completion_tokens": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_tokens": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Validate the stable top-level OpenAI-compatible chat-completion response fields and their data types. Generated identifiers, timestamps, selected model aliases, and token counts are validated by type rather than pinned to legacy example values.",
    "labels": [
      "litellm",
      "contract",
      "chat-completions",
      "response-schema"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
