{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-ERR-001",
  "summary": "Unknown virtual key returns token_not_found_in_db",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "invalid_api_key": "sk-invalid-not-a-real-litellm-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "unknownVirtualKeyError",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{invalid_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ]
          },
          "expectedStatus": 401,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "token_not_found_in_db"
                  },
                  "param": {
                    "const": "key"
                  },
                  "code": {
                    "const": "401"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify LiteLLM classifies a nonexistent virtual key as token_not_found_in_db and returns HTTP 401. The configured invalid credential must not exist in the gateway key store.",
    "labels": [
      "litellm",
      "error-handling",
      "authentication",
      "negative"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
