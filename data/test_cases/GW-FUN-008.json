{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-FUN-008",
  "summary": "Request JSON object response format",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-chat-api-key",
      "model_name": "replace-with-configured-chat-model-supporting-json-mode"
    },
    "actions": [
      {
        "id": "jsonObjectResponseFormat",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return a JSON object with a single field named status set to ok."
              }
            ],
            "response_format": {
              "type": "json_object"
            }
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "choices"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message",
                    "finish_reason"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "content"
                      ],
                      "properties": {
                        "content": {
                          "type": "string",
                          "pattern": "^\\s*\\{.*\"status\"\\s*:\\s*\"ok\".*\\}\\s*$"
                        }
                      }
                    },
                    "finish_reason": {
                      "const": "stop"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify the configured model supports response_format=json_object and returns an assistant content string shaped as a JSON object containing status=ok. The corpus runner can validate the outer response and content pattern but does not parse embedded JSON as a second document; the provider call can incur token costs.",
    "labels": [
      "litellm",
      "functional",
      "chat-completions",
      "json-mode",
      "structured-output"
    ],
    "source": "https://docs.litellm.ai/docs/completion/json_mode"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
