{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-FUN-005",
  "summary": "Accept valid and reject out-of-range temperature values",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-chat-api-key",
      "model_name": "replace-with-configured-chat-model-supporting-temperature"
    },
    "actions": [
      {
        "id": "validTemperatureAccepted",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ],
            "temperature": 0.0,
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      },
      {
        "id": "outOfRangeTemperatureRejected",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ],
            "temperature": 2.5,
            "stream": false
          },
          "expectedStatus": 400,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object"
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify temperature=0.0 is accepted and temperature=2.5 is rejected with HTTP 400 and an error object for a configured model that supports temperature and enforces the documented range. Parameter attribution and exact error text are provider/version-dependent and are not asserted. The valid chat request can incur provider token cost.",
    "labels": [
      "litellm",
      "functional",
      "chat-completions",
      "parameters",
      "validation"
    ],
    "source": "https://docs.litellm.ai/docs/completion"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
