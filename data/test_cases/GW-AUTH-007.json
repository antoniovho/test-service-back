{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-AUTH-007",
  "summary": "Standard virtual key denied administrative key generation",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-standard-litellm-virtual-key",
      "model_name": "replace-with-model-authorized-for-key"
    },
    "actions": [
      {
        "id": "standardKeyModelAccess",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return a short confirmation."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              }
            }
          }
        }
      },
      {
        "id": "standardKeyAdminDenied",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/key/generate",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "models": [
              "{{model_name}}"
            ]
          },
          "expectedStatus": 401,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "auth_error"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Confirm an ordinary virtual key can make an authorized model request but cannot create another key through the administrative endpoint. The test assumes the deployment requires master/admin authorization for key generation.",
    "labels": [
      "litellm",
      "auth",
      "authorization",
      "admin-endpoint"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
