{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-ERR-024",
  "summary": "Tag-based routing excludes every deployment",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-test-key-restricted-by-tags",
      "model_group": "replace-with-model-group-excluded-by-callers-tags"
    },
    "actions": [
      {
        "id": "tagRoutingDenied",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_group}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ]
          },
          "expectedStatus": 401,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "message",
                  "code"
                ],
                "properties": {
                  "message": {
                    "const": "Not allowed to access model due to tags configuration"
                  },
                  "code": {
                    "const": "401"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify a caller denied by configured tag-based model routing receives HTTP 401 with the exact Not allowed to access model due to tags configuration message and code 401. The key/tag policy and model group must be configured so every deployment is excluded before running.",
    "labels": [
      "litellm",
      "error-handling",
      "routing",
      "tags",
      "authorization"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
