{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-SMK-007",
  "summary": "Configured model is exposed and callable",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "findConfiguredModel",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/models",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Accept": "application/json"
          },
          "expectedStatus": 200,
          "expectedHeaders": {
            "Content-Type": "application/json"
          },
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "data"
            ],
            "properties": {
              "object": {
                "const": "list"
              },
              "data": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "object",
                    "created",
                    "owned_by"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "object": {
                      "const": "model"
                    },
                    "created": {
                      "type": "integer"
                    },
                    "owned_by": {
                      "type": "string"
                    }
                  }
                },
                "contains": {
                  "type": "object",
                  "required": [
                    "id",
                    "object"
                  ],
                  "properties": {
                    "id": {
                      "const": "{{model_name}}"
                    },
                    "object": {
                      "const": "model"
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "id": "invokeConfiguredModel",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the word OK."
              }
            ]
          },
          "expectedStatus": 200,
          "expectedHeaders": {
            "Content-Type": "application/json"
          },
          "expectedHeaderNames": [
            "x-litellm-call-id"
          ],
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "choices"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              },
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "const": "assistant"
                        },
                        "content": {
                          "type": "string",
                          "pattern": "^\\s*OK[.!]?\\s*$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Also covers GW-API-006's authenticated model-list contract. Verify the configured model appears in model discovery and can return a chat completion through the gateway. The source's 5-second timeout is not enforced by the current HTTP runner. The completion request can incur provider charges.",
    "labels": [
      "litellm",
      "model-discovery",
      "chat-completions",
      "smoke",
      "GW-API-006"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/model_discovery"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
