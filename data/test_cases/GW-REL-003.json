{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-REL-003",
  "summary": "Preserve a signed empty Anthropic thinking block",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-anthropic-api-key",
      "anthropic_model_name": "replace-with-configured-anthropic-compatible-model",
      "thinking_signature": "replace-with-signature-from-a-real-previous-response"
    },
    "actions": [
      {
        "id": "sendSignedEmptyThinkingBlock",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/messages",
          "method": "POST",
          "headers": {"Authorization": "Bearer {{litellm_virtual_key}}", "Content-Type": "application/json", "Accept": "application/json", "anthropic-version": "2023-06-01"},
          "json": {
            "model": "{{anthropic_model_name}}",
            "max_tokens": 32,
            "messages": [
              {"role": "assistant", "content": [{"type": "thinking", "thinking": "", "signature": "{{thinking_signature}}"}]},
              {"role": "user", "content": "Continue exactly from the signed turn."}
            ],
            "thinking": {"type": "enabled", "budget_tokens": 16},
            "prefix_mismatch_behavior": "error"
          },
          "expectedStatus": 400
        }
      }
    ]
  },
  "metadata": {
    "objective": "Exercise v1.106.1's signed-empty-thinking handling. Supply a deliberately non-matching real signature: the proxy must forward the provider binding mismatch (400) instead of removing the signed block and retrying. This fixture must never contain user reasoning or production data.",
    "labels": ["litellm", "release-1.106.1", "anthropic", "thinking", "signed-block", "regression"],
    "source": "https://docs.litellm.ai/release_notes/v1.106.1/v1-106-1"
  },
  "preconditionReferences": [{"preconditionKey": "LITELLM_PROXY_READY", "version": 1}]
}
