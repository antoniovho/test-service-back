{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-INT-003",
  "summary": "Persist and retrieve virtual-key and spend data through PostgreSQL",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "master_key": "replace-with-proxy-admin-key",
      "model_name": "replace-with-configured-chat-model"
    },
    "actions": [
      {
        "id": "createShortLivedIntegrationKey",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/key/generate",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{master_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "models": [
              "{{model_name}}"
            ],
            "duration": "1h",
            "metadata": {
              "integration_test": "GW-INT-003"
            }
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "key"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "capture": {
            "generated_test_key": "$.key"
          }
        }
      },
      {
        "id": "retrievePersistedIntegrationKey",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/key/info",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{master_key}}",
            "Accept": "application/json"
          },
          "query": {
            "key": "{generated_test_key}"
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "key",
              "info"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "info": {
                "type": "object",
                "required": [
                  "token",
                  "spend",
                  "models"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "minLength": 1
                  },
                  "spend": {
                    "type": "number",
                    "minimum": 0
                  },
                  "models": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "id": "makeProviderRequestWithPersistedKey",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {generated_test_key}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Generate a short database integration response."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "choices"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              },
              "choices": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      },
      {
        "id": "retrieveKeySpendAfterProviderRequest",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/key/info",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{master_key}}",
            "Accept": "application/json"
          },
          "query": {
            "key": "{generated_test_key}"
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "info"
            ],
            "properties": {
              "info": {
                "type": "object",
                "required": [
                  "spend"
                ],
                "properties": {
                  "spend": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify PostgreSQL-backed key creation, retrieval, authentication and spend-info persistence using documented /key/generate, /key/info and chat-completion routes. The generated test key expires after one hour. The final assertion verifies a numeric spend field is persisted but cannot compare it with the pre-request value or prove it increased; the source's spend-delta claim is therefore only partially checked. This mutates key state and sends a billable provider request; run only in an isolated environment with an approved cleanup policy.",
    "labels": [
      "litellm",
      "integration",
      "postgresql",
      "virtual-key",
      "spend-tracking"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
