{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-AIQ-012",
  "summary": "Relevance and groundedness",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "groundedAnswer",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "system",
                "content": "Context: [1] The Eiffel Tower was completed in 1889. Answer strictly using only the provided context and cite the source as [1]. If the answer is not in the context, say you don't know."
              },
              {
                "role": "user",
                "content": "When was the Eiffel Tower completed?"
              }
            ],
            "temperature": 0,
            "max_tokens": 60
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "const": "assistant"
                        },
                        "content": {
                          "const": "The Eiffel Tower was completed in 1889 [1]."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Check one context-grounded factual answer and citation against the source's expected text. A single exact-response assertion does not replace human/rubric groundedness evaluation or the source dataset's aggregate pass-rate check.",
    "labels": [
      "litellm",
      "ai-quality",
      "groundedness",
      "citation"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
