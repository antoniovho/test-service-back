{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-FBK-006",
  "summary": "Fallback serves a request after primary deployment failure",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-test-key",
      "primary_model_name": "replace-with-model-group-with-configured-fallback"
    },
    "actions": [
      {
        "id": "fallbackAfterPrimaryFailure",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{primary_model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return the fallback test response."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "content"
                      ],
                      "properties": {
                        "content": {
                          "const": "fallback-recovered"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "With the primary deployment externally configured to fail and its eligible fallback healthy and configured to return content=fallback-recovered, verify that the gateway returns a successful response containing that fixture result. Fixture setup and provider identity telemetry are not available in the corpus runner, so deployment attribution is not directly asserted.",
    "labels": [
      "litellm",
      "fallback",
      "routing",
      "provider-fixture"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/reliability"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
