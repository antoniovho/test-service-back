{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-AIQ-009",
  "summary": "Structured output adherence",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-json-mode-compatible-model"
    },
    "actions": [
      {
        "id": "jsonObjectCompletion",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "system",
                "content": "Return valid JSON only, matching schema {\"name\": string, \"age\": integer}. No extra keys, no prose."
              },
              {
                "role": "user",
                "content": "Generate a JSON object for a fictional person named Alice, age 30."
              }
            ],
            "response_format": {
              "type": "json_object"
            },
            "temperature": 0,
            "max_tokens": 50
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "const": "assistant"
                        },
                        "content": {
                          "type": "string",
                          "pattern": "^\\s*\\{\\s*(?:\\\"name\\\"\\s*:\\s*\\\"Alice\\\"\\s*,\\s*\\\"age\\\"\\s*:\\s*30|\\\"age\\\"\\s*:\\s*30\\s*,\\s*\\\"name\\\"\\s*:\\s*\\\"Alice\\\")\\s*\\}\\s*$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Check a JSON-mode chat completion returns only the expected name and age properties, accepting either property order and whitespace. The runner does not parse JSON embedded in message.content or measure aggregate schema adherence across the source evaluation set.",
    "labels": [
      "litellm",
      "ai-quality",
      "structured-output",
      "json-mode"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
