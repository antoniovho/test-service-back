{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-INT-002",
  "summary": "Serve identical chat requests from the Redis response cache",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-valid-litellm-api-key",
      "model_name": "replace-with-cacheable-chat-model"
    },
    "actions": [
      {
        "id": "verifyRedisCacheHealth",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/cache/ping",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Accept": "application/json"
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "status",
              "cache_type",
              "ping_response"
            ],
            "properties": {
              "status": {
                "const": "healthy"
              },
              "cache_type": {
                "const": "redis"
              },
              "ping_response": {
                "const": true
              }
            }
          }
        }
      },
      {
        "id": "populateResponseCache",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Redis integration cache test: return a short deterministic response."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "choices"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              },
              "choices": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      },
      {
        "id": "verifyIdenticalRequestCacheHit",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Redis integration cache test: return a short deterministic response."
              }
            ],
            "stream": false
          },
          "expectedStatus": 200,
          "expectedHeaderNames": [
            "x-litellm-cache-key"
          ],
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "choices"
            ],
            "properties": {
              "object": {
                "const": "chat.completion"
              },
              "choices": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify /cache/ping reports a healthy Redis cache, then confirm an identical second chat request returns the documented x-litellm-cache-key response header. Requires Redis-backed response caching to be enabled and the selected model to be cacheable. The source's wait-for-TTL-expiry and upstream-call-count checks are omitted because the action model has no wait or provider telemetry assertion. The first chat request can incur provider costs.",
    "labels": [
      "litellm",
      "integration",
      "redis",
      "response-cache",
      "cache-hit"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/caching"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
