{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-AIQ-003",
  "summary": "Instruction following",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "formatFollowing",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Respond with exactly three bullet points, each starting with '- ', summarizing the water cycle. Do not include any other text before or after the bullets."
              }
            ],
            "temperature": 0,
            "max_tokens": 150
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "choices"
            ],
            "properties": {
              "choices": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "message"
                  ],
                  "properties": {
                    "message": {
                      "type": "object",
                      "required": [
                        "role",
                        "content"
                      ],
                      "properties": {
                        "role": {
                          "const": "assistant"
                        },
                        "content": {
                          "type": "string",
                          "pattern": "^(?:- [^\\r\\n]+\\n){2}- [^\\r\\n]+$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify one response has exactly three non-empty lines prefixed by '- ' and no surrounding text. Aggregate pass-rate scoring over the approved evaluation dataset is not part of this case.",
    "labels": [
      "litellm",
      "ai-quality",
      "instruction-following",
      "format"
    ],
    "source": "https://docs.litellm.ai/docs/completion/input"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    },
    {
      "preconditionKey": "LITELLM_CHAT_MODEL_READY",
      "version": 1
    }
  ]
}
