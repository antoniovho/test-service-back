{
  "kind": "test-case",
  "schemaVersion": "1.2.0",
  "testCaseKey": "GW-AUTH-003",
  "summary": "Invalid virtual key rejected",
  "definition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "invalid_api_key": "sk-invalid-not-a-real-litellm-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "invalidVirtualKey",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/chat/completions",
          "method": "POST",
          "headers": {
            "Authorization": "Bearer {{invalid_api_key}}",
            "Content-Type": "application/json",
            "Accept": "application/json"
          },
          "json": {
            "model": "{{model_name}}",
            "messages": [
              {
                "role": "user",
                "content": "Return a short confirmation."
              }
            ],
            "stream": false
          },
          "expectedStatus": 401,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "auth_error"
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verify an unrecognized virtual-key credential is rejected before an authorized model request can complete. Also covers GW-CON-004's invalid-credential HTTP 401 status check. Authentication must be enabled and the configured invalid_api_key value must not exist in the LiteLLM key store.",
    "labels": [
      "litellm",
      "auth",
      "negative",
      "invalid-credential",
      "GW-CON-004"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/virtual_keys"
  },
  "preconditionReferences": [
    {
      "preconditionKey": "LITELLM_PROXY_READY",
      "version": 1
    }
  ]
}
