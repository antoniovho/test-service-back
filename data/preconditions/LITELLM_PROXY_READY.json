{
  "kind": "precondition",
  "schemaVersion": "1.2.0",
  "preconditionKey": "LITELLM_PROXY_READY",
  "summary": "LiteLLM Proxy readiness endpoint reports a healthy service",
  "validationDefinition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000"
    },
    "actions": [
      {
        "id": "proxyReadiness",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/health/readiness",
          "method": "GET",
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "healthy"
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Checks the unauthenticated readiness probe documented by LiteLLM. This verifies process readiness and configured database connectivity, not provider/model health.",
    "labels": [
      "litellm",
      "health",
      "readiness"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/health"
  }
}
