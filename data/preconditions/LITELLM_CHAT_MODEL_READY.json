{
  "kind": "precondition",
  "schemaVersion": "1.2.0",
  "preconditionKey": "LITELLM_CHAT_MODEL_READY",
  "summary": "Configured LiteLLM chat model is listed for the test key",
  "validationDefinition": {
    "schemaVersion": "1.1",
    "variables": {
      "gateway_base_url": "http://localhost:4000",
      "litellm_virtual_key": "replace-with-litellm-api-key",
      "model_name": "replace-with-configured-model-name"
    },
    "actions": [
      {
        "id": "chatModelHealth",
        "type": "HTTP",
        "configuration": {
          "url": "{{gateway_base_url}}/v1/models",
          "method": "GET",
          "headers": {
            "Authorization": "Bearer {{litellm_virtual_key}}"
          },
          "expectedStatus": 200,
          "expectedJsonSchema": {
            "type": "object",
            "required": [
              "object",
              "data"
            ],
            "properties": {
              "object": {
                "const": "list"
              },
              "data": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "required": [
                    "id"
                  ],
                  "properties": {
                    "id": {
                      "const": "{{model_name}}"
                    }
                  }
                }
              }
            }
          }
        }
      }
    ]
  },
  "metadata": {
    "objective": "Verifies that GET /v1/models lists the configured model for the test key without sending an inference prompt. Wildcard model discovery may still query provider endpoints.",
    "labels": [
      "litellm",
      "health",
      "model"
    ],
    "source": "https://docs.litellm.ai/docs/proxy/model_discovery"
  }
}
